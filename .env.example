# ===== Zelvoraq AI assistant (server-side only, never exposed to the browser) =====
# Anthropic API key used by app/api/chat/route.ts. Without this set, the assistant
# runs in labeled demo mode (scripted qualifying responses, no live model calls).
ANTHROPIC_API_KEY=

# ===== Lead capture (app/api/lead/route.ts) =====
# Optional: forward submitted leads to a CRM/automation webhook (Zapier, Make, HubSpot, etc).
CRM_WEBHOOK_URL=

# Optional: transactional email provider for lead-notification emails.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# ===== Booking =====
# Public: safe to expose to the browser (used to embed/link the booking calendar).
NEXT_PUBLIC_BOOKING_URL=https://cal.com/zelvoraq

# ===== Analytics =====
NEXT_PUBLIC_GA4_ID=
